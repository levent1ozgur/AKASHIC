# AKASHIC — Environment Variables
# Optional overrides. AKASHIC uses config.yaml by default — only set
# variables here if you need to override values at runtime without
# modifying config.yaml.

# Ollama / embedding endpoint
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding model name
# EMBEDDING_MODEL=qwen3-embedding:0.6b

# Reranker model path (local path or HuggingFace model ID)
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Obsidian vault path
# VAULT_PATH=/path/to/your/obsidian/vault
